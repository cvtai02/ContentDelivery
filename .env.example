# ── Zhihu ─────────────────────────────────────────────────────────────────────
# Cookie từ trình duyệt khi đăng nhập Zhihu (F12 → Network → bất kỳ request → Cookie header)
# Chỉ cần giá trị của cookie z_c0, nhưng paste toàn bộ Cookie header cũng được
ZHIHU_COOKIE=z_c0=your_z_c0_cookie_value

REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=web:mynews:v1.0.0 by u_your_reddit_username

# ── Facebook App ──────────────────────────────────────────────────────────────
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret

# Short-lived user token — renew when expired, only used by "npm run facebook-token"
FACEBOOK_ACCESS_TOKEN=your_user_access_token_with_pages_permissions

# ── Facebook Targets (Pages / Groups) ─────────────────────────────────────────
# JSON array — add one object per page/group. Run "npm run facebook-token" to populate.
# Schema: [{"id":"page_id","name":"Page Name","token":"never_expiring_page_token"}, ...]
FACEBOOK_TARGETS=[{"id":"your_page_id","name":"Your Page Name","token":"your_page_token"}]
